{
  "name": "zmartify-admin",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "HVAC Edge Gateway Admin PWA",
  "main": "dist/index.es.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run firmware:validate && tsc && vite build",
    "build:native": "npm run firmware:validate && tsc && vite build --mode native",
    "firmware:validate": "node scripts/validate-firmware-catalog.mjs",
    "firmware:publish": "node scripts/publish-firmware-release.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint .",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:ios": "npm run build:native && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "ios:build": "./scripts/build_ios.sh",
    "cap:copy": "npx cap copy",
    "phase:deploy": "npm run build && cd ../../ && ./ops/deploy_edge.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "8.4.3",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^8.8.19",
    "@ionic/react-router": "^8.8.19",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.5.6",
    "framer-motion": "^12.43.0",
    "ionicons": "^7.1.0",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
