# Clean v2 Raspberry Pi deployment settings. Copy to .env and replace secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_API_TOKEN=replace-with-a-long-random-token
ZMART_EDGE_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-key

# Public DNS names and the certbot certificate name under /etc/letsencrypt.
ZMARTIFY_TLS_DOMAIN=app.zmartify.dk
ZMART_EDGE_PUBLIC_API_BASE=https://api.zmartify.dk
ZMART_EDGE_PUBLIC_MQTT_URI=mqtts://mqtt.zmartify.dk:8883

# Optional strict validation for a clean deployment.
ZMART_EDGE_CONTRACT_VALIDATION_MODE=enforce
